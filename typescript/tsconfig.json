{
  // node が .ts を直接実行する (type stripping) 前提の設定
  // https://nodejs.org/api/typescript.html
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    // 型を消すだけでは実行できない構文 (enum / namespace など) を禁止する
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  }
}
