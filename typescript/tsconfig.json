{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    // node は .ts をそのまま実行するので、import も拡張子付きで書く（leetcode/ 用）
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  }
}
